{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // #501 slice b: the PRODUCTION Worker config. Inactive until the deploy workflow (slice d) exists: nothing reads this file yet, there is no route, and the Hyperdrive id is a placeholder.
  // tests/wrangler-prod-501b.test.mjs keeps it in sync with wrangler.jsonc; the differences are listed there. Never put a secret value in this file (Worker secrets are set on the Worker only).
  "name": "harimu-production",
  "account_id": "143bccf1a31c2161142c43845a8fc65d",
  // Custom entry re-exports vinext and adds the CityPresence Durable Object (#76).
  "main": "./worker/entry.ts",
  // Pinned to the installed workerd runtime; advance after upgrading/testing Wrangler.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "gcp:us-central1" },
  // #247: scheduled Worker for AI Cabinet petition responses (no-op unless HARIMU_AI_CABINET_RESPONSES_ENABLED="true").
  "triggers": { "crons": ["*/15 * * * *"] },
  // PLACEHOLDER: the production Hyperdrive config does not exist yet (Patrick creates it, pointing at the PlanetScale runtime role). Replace the id with the real config id, which is not a secret.
  // The id below is deliberately not a valid id, and assertProductionConfig (slice c) refuses to deploy while it is a placeholder.
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "PLACEHOLDER-production-hyperdrive-config-id"
  }],
  "ai": { "binding": "AI" },
  // No routes and no zone yet (inactive): the custom domain app.harimu.com is added by the production deploy slice, never here by hand.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // #790: square chat shadow-mute (docs 21.3), new messages only. Operator list of citizenId@muteISO or citizenId@muteISO..unmuteISO entries (max 90; unmute by closing the window, not deleting it), comma-separated, not a secret. Empty: nobody is muted. Malformed: mutes nobody, logs a warning.
    // #790 unmute: close the window (id@mute..unmute) so posts made during the mute stay hidden. Deleting an entry reveals that window's posts; only do it as a deliberate admin action.
    "HARIMU_CHAT_SHADOW_MUTE": "",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaGFyaW11LmNvbSQ",
    "HARIMU_ACCOUNT_ELECTION_POC_ENABLED": "false",
    "HARIMU_STORAGE_MAINTENANCE": "false",
    "HARIMU_STORAGE_BACKEND": "postgres",
    // #501a: the explicit production storage path (lib/storage-selection.ts): Postgres only, never D1, fails closed. Needs the preview marker and the temporary admin waiver to be absent.
    "HARIMU_PRODUCTION_STORAGE": "true",
    "HARIMU_POSTGRES_CUTOVER_READY": "true",
    "HARIMU_AI_NEWS_ENABLED": "false",
    "HARIMU_NOTABLES_ENABLED": "false",
    "HARIMU_AI_CABINET_RESPONSES_ENABLED": "false",
    "HARIMU_CITY_FOUNDING_ENABLED": "false",
    // #988 / #1003 / #1006 / #1001 / #1007 / #1014 / #798 / #1028: one JSON binding for city tier growth, panel notes (civic unit, imports, governor, population band, capture history) and the spa WC bonus (Cloudflare text-binding limit). Preview on, production off. A direct HARIMU_* var still wins.
    "HARIMU_CITY_PACK": {
      "HARIMU_CITY_TIER_GROWTH_ENABLED": "false",
      "HARIMU_CITY_TIER_UNLOCKS_ENABLED": "false",
      "HARIMU_CITY_TIER_FESTIVAL_NOTE_ENABLED": "false",
      "HARIMU_CITY_SPECIALTY_NOTE_ENABLED": "false",
      "HARIMU_CITY_CAPTURE_NOTE_ENABLED": "false",
      "HARIMU_CITY_CIVIC_UNIT_NOTE_ENABLED": "false",
      "HARIMU_CITY_IMPORTS_NOTE_ENABLED": "false",
      "HARIMU_CITY_GOVERNOR_NOTE_ENABLED": "false",
      "HARIMU_CITY_TIER_POPULATION_NOTE_ENABLED": "false",
      "HARIMU_CITY_CAPTURE_HISTORY_ENABLED": "false",
      "HARIMU_SPA_WC_BONUS_ENABLED": "false",
      "HARIMU_SEASON_SEA_LANES_ENABLED": "false",
      // #1285: city panel "Hosts …" line for Isling Springs, Shen Springs and Lanu Terraces. Off: those keys are absent and the panel is unchanged. Also needs that city's festival flag.
      "HARIMU_CITY_FESTIVAL_HOST_NOTE_ENABLED": "false"
    },
    // #742: AI kill switch (operator control, not a feature flag). "" = off; "all" or a comma list of nation ids switches that narrative to templates (no model call, no AI spend). Unknown values fail closed to "all".
    "HARIMU_AI_TEMPLATES_ONLY": "",
    // #764: per-persona AI mute (operator control, not a feature flag). "" = off; "all" or a comma list of persona ids (Notable ids, <nation>-news-desk, kindle-cabinet, kindle-town-hall, kindle-debate) skips that persona's model calls. Unknown values fail closed to "all".
    "HARIMU_AI_MUTED_PERSONAS": "",
    "HARIMU_AI_DAILY_BUDGET_MICRO": "970000",
    "HARIMU_SQUARE_PURCHASE_ENABLED": "false",
    // #626 (Decision 111): the Spark-to-Tessera kiosk exchange, separate from square purchases. Off: buy-tessera is refused and the kiosk stays closed.
    "HARIMU_TESSERA_EXCHANGE_ENABLED": "false",
    // #631: preview-only Tessera TEST faucet (50.00 TSR once per citizen, labeled test). Off; it also needs NEXT_PUBLIC_HARIMU_DEVELOPMENT_PREVIEW=true, so production refuses it.
    "HARIMU_TEST_FAUCET_ENABLED": "false",
    // #489: per-nation opening flags (seven-nations Stage 0). Off; even when "true" a nation is enrollable only by a QA-allowlisted account (lib/nation-openings.ts nationPlayable).
    // #487: Confluence PoC. "true" in preview only (QA-allowlisted accounts); production "false".
    "HARIMU_CONFLUENCE_ENABLED": "false",
    "HARIMU_MERIDIAN_ENABLED": "false",
    "HARIMU_ILMAR_ENABLED": "false",
    "HARIMU_HOARVALE_ENABLED": "false",
    "HARIMU_VARKAND_ENABLED": "false",
    "HARIMU_VELDWOOD_ENABLED": "false",
    "HARIMU_FULMARA_ENABLED": "false",
    // #486 (Stage 0 closeout): a flag-on nation opens only when its registry entry is complete (capital and biome, currency, wage fund, jobs). Off: unchanged.
    "HARIMU_NATION_READINESS_ENABLED": "false",
    // #988: one JSON binding for the gray-market and Korund plan flags, the labor bureau, the internal residence permit, and the savings shield (Cloudflare text-binding limit). Preview on, production off. A direct HARIMU_* var still wins.
    "HARIMU_GRAY_PACK": {
      "HARIMU_GRAY_MARKET_ENABLED": "false",
      "HARIMU_GRAY_DAILY_CAP_ENABLED": "false",
      "HARIMU_GRAY_SUSPICION_ENABLED": "false",
      "HARIMU_GRAY_SEIZURE_ENABLED": "false",
      "HARIMU_GRAY_RATION_RISE_ENABLED": "false",
      "HARIMU_KORUND_MEDALS_ENABLED": "false",
      // #994: Plan medals raise displayed Standing on the Korund plan (derived on read from the #737 medal total; citizens.standing is not written). Off: no planStanding, panel unchanged. Also needs HARIMU_KORUND_MEDALS_ENABLED.
      "HARIMU_KORUND_STANDING_ENABLED": "false",
      "HARIMU_KORUND_SHORTFALL_ENABLED": "false",
      "HARIMU_KORUND_PLAN_STATS_ENABLED": "false",
      "HARIMU_WALLET_STREET_RATE_ENABLED": "false",
      // #1000: Labor Note balance shows its Tessera value at the Bureau rate, marked not convertible (docs §12.8 Display). Off: no line. Display only.
      "HARIMU_KORUND_TSR_VIEW_ENABLED": "false",
      "HARIMU_KORUND_RATION_CUT_ENABLED": "false",
      "HARIMU_KORUND_RATION_STABILITY_ENABLED": "false",
      "HARIMU_KORUND_STABILITY_RECOVERY_ENABLED": "false",
      "HARIMU_LABOR_BUREAU_ENABLED": "false",
      // #992: closed-system internal residence permit for home-city moves (Korund, Meridian; Varkand at Amber/Red). Off: #781 path unchanged.
      "HARIMU_INTERNAL_PERMIT_ENABLED": "false",
      // #1081: Varkand Alert Level stored by the Directorate (admin route); feeds the #992 permit check and the Varkand nation read. Off: always Green.
      "HARIMU_VARKAND_ALERT_ENABLED": "false",
      // #824: Kindle Dormant Savings Shield: on return from Dormant or Archived, a verified Kindle citizen gets min(SPK balance, 240 SPK cap) x 1/2 x the Price Index rise, once per absence, from the treasury welfare line. Off: no read, no write, no copy.
      "HARIMU_SAVINGS_SHIELD_ENABLED": "false",
      // #1016: closed Kindle presidential ballot shows High Court certification (awaiting for 24 hours, then certified). Off: no certification field, ballot unchanged. Display only.
      "HARIMU_KINDLE_CERTIFICATION_ENABLED": "false",
      // #1033: game season scales farming shift output (docs §17.1). Off: the same units and the same result line.
      "HARIMU_SEASON_FARMING_ENABLED": "false",
      // #1047: daily soft cap on productive shifts (docs §17.3). Off: no count, no refusal, no extra query.
      "HARIMU_SHIFT_SOFT_CAP_ENABLED": "false",
      // #1085: Varkand Directorate of the Five Commands. The Chair rotates every 60 real days. Off: no directorate key on the government snapshot.
      "HARIMU_VARKAND_DIRECTORATE_ENABLED": "false",
      // #1094: Varkand Mandate Plebiscite every 150 real days. Off: no mandatePlebiscite key on the government snapshot.
      "HARIMU_VARKAND_PLEBISCITE_ENABLED": "false",
      // #1096: Hoarvale Moot term (120 real days) and 7-day investiture deadline. Off: no moot key on the government snapshot.
      "HARIMU_HOARVALE_MOOT_ENABLED": "false",
      // #1098: Veldwood Federal Council term, 120 real days, and the Council Speaker seat. Off: no federalCouncil key on the government snapshot.
      "HARIMU_VELDWOOD_COUNCIL_ENABLED": "false",
      // #1102: Fulmara Council of Ten (30 real days), Lodestar (90 real days, no consecutive re-election) and Tribune session. Off: no grandCouncil key.
      "HARIMU_FULMARA_COUNCIL_ENABLED": "false",
      // #1107: Ilmar Oracle life term, Stilldays, and the Great Pilgrimage on the government read. Off: no sanctum key.
      "HARIMU_ILMAR_SANCTUM_CALENDAR_ENABLED": "false",
      // #1113: Confluence Four Pillars and the next Party Congress on the government read. Off: no party key.
      "HARIMU_CONFLUENCE_PARTY_SCHEDULE_ENABLED": "false",
      // #1114: Meridian Paramount Leader roles, 7-seat Standing Committee, and the next Party Congress (every 150 real days) on the government read. Off: no partyState key.
      "HARIMU_MERIDIAN_PARTY_SCHEDULE_ENABLED": "false",
      // #1116: Korund Five-Year Plan start, next Plan Day (every 150 real days) and next quarterly Quota Rally on the government read. Off: no planCalendar key.
      "HARIMU_KORUND_PLAN_CALENDAR_ENABLED": "false",
      // #1122: Veldwood next Vote Day, every 15 real days. Off: no voteDayCalendar key on the government snapshot.
      "HARIMU_VELDWOOD_VOTE_DAY_ENABLED": "false",
      // #1118: Aurelle reign-start display clock and the next Great Council window. Off: no crownCalendar key.
      "HARIMU_AURELLE_CROWN_CALENDAR_ENABLED": "false",
      // #1123: Confluence next People's Assembly election window (every 150 real days) on the government read. Off: no assemblyElection key.
      "HARIMU_CONFLUENCE_ASSEMBLY_ELECTION_ENABLED": "false",
      // #1117: Kindle presidential term end and the next Ballot Night on the government read. Off: no electionClock key. A held cycle start also adds no key.
      "HARIMU_KINDLE_ELECTION_CLOCK_ENABLED": "false",
      // #1133: Meridian next Exam Day (once per game year). Off: no examDay key.
      "HARIMU_MERIDIAN_EXAM_DAY_ENABLED": "false",
      // #1136: Hoarvale next Honors List Day (once per game year = 30 real days) on the government read. Off: no honorsListDay key.
      "HARIMU_HOARVALE_HONORS_LIST_DAY_ENABLED": "false",
      // #1130: Fulmara shareholder resolutions (title, status, share totals) on the government read. Off: no resolutions key.
      "HARIMU_FULMARA_RESOLUTIONS_ENABLED": "false",
      // #1134: a Hoarvale bill that is still pending receives Royal Assent after 48 real hours, on the world tick. Off: no auto-advance, and the government read omits secondsUntilAssent.
      "HARIMU_HOARVALE_AUTO_ASSENT_ENABLED": "false",
      // #1137: Ilmar next Feast of First Light (every 15 real days, twice per game year). Off: no feastOfFirstLight key.
      "HARIMU_ILMAR_FEAST_OF_FIRST_LIGHT_ENABLED": "false",
      // #1145: Kindle next Founders' Forge Day (once per game year = 30 real days) on the government read. Off: no foundersForgeDay key.
      "HARIMU_KINDLE_FOUNDERS_FORGE_DAY_ENABLED": "false",
      // #1151: Varkand next Muster Day (once per game year = 30 real days) on the government read. Off: no musterDay key.
      "HARIMU_VARKAND_MUSTER_DAY_ENABLED": "false",
      // #1146: Aurelle next Hearth Night (Kinward Rite blessing of houses, once per game year = 30 real days). Off: no hearthNight key.
      "HARIMU_AURELLE_HEARTH_NIGHT_ENABLED": "false",
      // #1139: Ilmar Prism contracts (title and whole-number profit share) on the government read. Off: no contracts key.
      "HARIMU_ILMAR_PRISM_CONTRACTS_ENABLED": "false",
      // #1147: Korund next Chairman's Birthday (once per game year, 30 real days). Off: no chairmanBirthday key.
      "HARIMU_KORUND_CHAIRMAN_BIRTHDAY_ENABLED": "false",
      // #1159: Veldwood next Dividend Day (once per game year = 30 real days). Off: no dividendDay key. Pays no dividend and states no amount.
      "HARIMU_VELDWOOD_DIVIDEND_DAY_ENABLED": "false",
      // #1150: Fulmara next Exchange Bell (once per game year = 30 real days) on the government read. Off: no exchangeBell key.
      "HARIMU_FULMARA_EXCHANGE_BELL_ENABLED": "false",
      // #1160: Hoarvale next Aurora Night (once per game year, 30 real days, no midwinter offset). Off: no auroraNight key.
      "HARIMU_HOARVALE_AURORA_NIGHT_ENABLED": "false",
      // #1164: Kindle next Market Bell (stock-exchange opening anniversary, once per game year = 30 real days) on the government read. Off: no marketBell key.
      "HARIMU_KINDLE_MARKET_BELL_ENABLED": "false",
      // #1165: Confluence next Canal Festival (once per game year = 30 real days) on the government read. Off: no canalFestival key.
      "HARIMU_CONFLUENCE_CANAL_FESTIVAL_ENABLED": "false",
      // #1169: Confluence next Quota Day (once per game year = 30 real days). Off: no quotaDay key. States no quota, target, or bonus.
      "HARIMU_CONFLUENCE_QUOTA_DAY_ENABLED": "false",
      // #1170: Korund next People's Congress (once per game year, 30 real days, zero offset). Off: no peoplesCongress key.
      "HARIMU_KORUND_PEOPLES_CONGRESS_ENABLED": "false",
      // #1175: Meridian next Turbine Day (anniversary of the national grid, once per game year = 30 real days). Shen Springs hosts it. Off: no turbineDay key.
      "HARIMU_MERIDIAN_TURBINE_DAY_ENABLED": "false",
      // #1178: Fulmara next Grand Regatta (once per game year = 30 real days). Off: no grandRegatta key. Holds no race.
      "HARIMU_FULMARA_GRAND_REGATTA_ENABLED": "false",
      // #1179: Fulmara next Charter Day (once per game year = 30 real days, zero offset). Off: no charterDay key. Date only.
      "HARIMU_FULMARA_CHARTER_DAY_ENABLED": "false",
      // #1184: Fulmara next Fair-Wind Blessing (once per game year = 30 real days, no offset). Off: no fairWindBlessing key. Holds the next date only.
      "HARIMU_FULMARA_FAIR_WIND_BLESSING_ENABLED": "false",
      // #1183: Confluence next Congress Lanterns (once per game year = 30 real days, no offset). Off: no congressLanterns key. Date only.
      "HARIMU_CONFLUENCE_CONGRESS_LANTERNS_ENABLED": "false",
      // #1187: Fulmara next Dock Strike remembrance (once per game year = 30 real days). Off: no dockStrikeRemembrance key. Holds no remembrance.
      "HARIMU_FULMARA_DOCK_STRIKE_REMEMBRANCE_ENABLED": "false",
      // #1189: Meridian next Congress Week (every 5 game years = 150 real days). Off: no congressWeek key. Date only.
      "HARIMU_MERIDIAN_CONGRESS_WEEK_ENABLED": "false",
      // #1191: Aurelle next Coronation Day (once per game year = 30 real days, zero offset). Off: no coronationDay key. Date only.
      "HARIMU_AURELLE_CORONATION_DAY_ENABLED": "false",
      // #1196: Ilmar next Great Pilgrimage (once per game year = 30 real days, no offset). Off: no greatPilgrimage key. Holds the next date only.
      "HARIMU_ILMAR_GREAT_PILGRIMAGE_ENABLED": "false",
      // #1197: Aurelle next Charter Fair (once per game year = 30 real days, no offset). Off: no charterFair key. Date only.
      "HARIMU_AURELLE_CHARTER_FAIR_ENABLED": "false",
      // #1193: World atlas reads (simulation.clock.nextFestival from the enabled nation holiday clocks). Off: no nextFestival key. Dates only.
      "HARIMU_WORLD_ATLAS_READS_ENABLED": "false",
      // #1207: Varkand next Rotation Day (existing Chair term = 60 real days). Off: no rotationDay key. Date only. Canceled only while a stored Red Alert holds.
      "HARIMU_VARKAND_ROTATION_DAY_ENABLED": "false",
      // #1208: Hoarvale next Opening of the Moot (start of the next Moot term, zero offset). Off: no mootOpening key. Date only.
      "HARIMU_HOARVALE_MOOT_OPENING_ENABLED": "false",
      // #1211: Varkand next Lantern Watch (once per 30 real days, no offset). Off: no lanternWatch key. Date only.
      "HARIMU_VARKAND_LANTERN_WATCH_ENABLED": "false",
      "HARIMU_ILMAR_ASSEMBLY_ELECTION_DAY_ENABLED": "false",
      // #1219: Hoarvale next Election Night (the election that ends the current Moot term, zero offset). Off: no electionNight key. Date only.
      "HARIMU_HOARVALE_ELECTION_NIGHT_ENABLED": "false",
      // #1220: Varkand celebrations on the government read are marked canceled at a stored Red Alert. Off: the read is unchanged. Dates stay put. The Mandate Plebiscite is not marked.
      "HARIMU_VARKAND_RED_ALERT_CANCELS_ENABLED": "false",
      // #1241: Brasswell Port is a Kindle resident city (home, enroll, travel-by-id). Not an Assembly district and not a country-map pin. Off: the city is absent.
      "HARIMU_KINDLE_BRASSWELL_PORT_ENABLED": "false",
      // #1243: Aurelle next Kite Festival (each game spring, once per game year = 30 real days, offset 0). Off: no kiteFestival key. Date only.
      "HARIMU_AURELLE_KITE_FESTIVAL_ENABLED": "false",
      // #1244: Veldwood next midsummer Ring Moot (once per game year = 30 real days, midsummer offset 11.25 days). Off: no ringMoot key. Date only.
      "HARIMU_VELDWOOD_RING_MOOT_ENABLED": "false",
      // #1245: Ilmar next Clearing (Lumen Canon new year, once per game year = 30 real days, offset 0). Off: no clearing key. Date only.
      "HARIMU_ILMAR_CLEARING_ENABLED": "false",
      // #1242: Dunmorrow is an Aurelle resident city (home, enroll, travel-by-id). With Hearth Night also on, its city panel reads "Hosts Hearth Night" and that clock's next date. Not a country-map pin. Off: the city is absent and the panel is unchanged.
      "HARIMU_AURELLE_DUNMORROW_ENABLED": "false",
      // #1259: Corvel Isles is a Fulmara resident city (home, enroll, travel-by-id). With the Grand Regatta also on, its city panel reads "Hosts the Grand Regatta" and that clock's next date. Not a country-map pin. Off: the city is absent and the panel is unchanged.
      "HARIMU_FULMARA_CORVEL_ISLES_ENABLED": "false",
      // #1260: Ilmar next Long Light midsummer vigil (once per game year = 30 real days, midsummer offset 11.25 days). Off: no longLight key. Date only. Own flag only, not the Sanctum or Clearing flags.
      "HARIMU_ILMAR_LONG_LIGHT_ENABLED": "false",
      // #1261: Vakk Harbor is a Hoarvale resident city (home, enroll, travel-by-id). Not a country-map pin. Off: the city is absent.
      "HARIMU_HOARVALE_VAKK_HARBOR_ENABLED": "false",
      // #1270: Ruel Works is a Confluence resident city (home, enroll, travel-by-id). Not a country-map pin. citiesForNation stays capital plus two. No festival host line, no imports, no sea-lane effect. Off: the city is absent.
      "HARIMU_CONFLUENCE_RUEL_WORKS_ENABLED": "false",
      // #1271: Thessaly Wells is an Ilmar resident city (home, enroll, travel-by-id). Existing specialty and heartland capture reads apply. Not a country-map pin. No imports. Off: the city is absent and the panel is unchanged.
      "HARIMU_ILMAR_THESSALY_WELLS_ENABLED": "false",
      // #1275: Marrow Mills is a Veldwood resident city (home, enroll, travel-by-id). Not a country-map pin. citiesForNation stays capital plus two. No festival host line, no imports, no sea-lane effect. Off: the city is absent.
      "HARIMU_VELDWOOD_MARROW_MILLS_ENABLED": "false",
      // #1279: Dao Works is a Meridian resident city (home, enroll, travel-by-id). Not a country-map pin. Off: the city is absent.
      "HARIMU_MERIDIAN_DAO_WORKS_ENABLED": "false",
      // #1282: Dunkar Pass is a Varkand resident city (home, enroll, travel-by-id). Not a country-map pin. citiesForNation stays capital plus two. No garrison duty, key defense, or war-value hooks. Off: the city is absent.
      "HARIMU_VARKAND_DUNKAR_PASS_ENABLED": "false",
      // #1318: inert Better Auth at /api/auth/* and the Twilio Verify adapter. Off: that path is 404 and the database is not opened. Clerk stays the only session authority. Secrets are dashboard-only and are not set here: BETTER_AUTH_SECRET (a different value on each Worker), TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET, TWILIO_VERIFY_SERVICE_SID, and HARIMU_PHONE_HASH_SECRET (the same value on preview and production while they share a database). The base URL is the request origin.
      "HARIMU_BETTER_AUTH_ENABLED": "false",
      // #469: inert World ID adapter at /api/world-id/*. Off, or HARIMU_WORLD_ID_VERIFIER_SECRET unset: 404 and no fetch. The secret is not set here. Nullifiers are a later slice and must not link to a public profile.
      "HARIMU_WORLD_ID_ENABLED": "false",
      // #1341: a citizen who bought a square can place one kit poster there (one frame and one slogan). Off: no poster read or write, and the registry response is unchanged.
      "HARIMU_SQUARE_POSTERS_ENABLED": "false"
    },
    // #844: Kindle sales tax: each fill on Kindle's goods market or fixed-lot listing sale (Kindle's market by definition; any seller nation) remits 5% of the gross from the proceeds to kindle-treasury (migrations 0081, 0083). Off: no tax row written and no tax INSERT runs; balances still sum the empty tax tables.
    "HARIMU_KINDLE_SALES_TAX_ENABLED": "false",
    // #886 (a): the MVP job-type catalog (8 types, ARC on #886) at GET /api/jobs/types. Off: 404; nothing else reads it.
    "HARIMU_MVP_JOB_TYPES_ENABLED": "false",
    // #781: move your home city within your own nation for a fee of 10 units of the nation's wallet currency (SPK Kindle, LN Korund; no wallet currency: not_open_yet), once per 7 real days (POST /api/city/home). Off: 404 before auth, no read or write; home stays the capital.
    "HARIMU_HOME_CITY_MOVE_ENABLED": "false",
    // #965: choose a home city at enrollment from the nation's catalog (lib/cities.ts); the capital is preselected and used when cityId is omitted. Off: cityId is ignored and home stays the capital. No home_city_moves row, so the #781 fee and cooldown do not start.
    "HARIMU_ENROLL_HOME_CITY_ENABLED": "false",
    // #777: goods-market seller fee (0.5%, rounded down) written as a sink row with each fill and netted from the wallet. Off: no fee written or read.
    "HARIMU_MARKET_FEE_ENABLED": "false",
    // #490 (Stage 0d): generic per-nation wage ledger and work commands. Off: the commands are 404 and nothing is written. Also needs a nation that is playable for the account (#489) with jobs in lib/nation-openings.ts (only Confluence, #487).
    // #487: "true" in preview only so the Confluence cooperative job runs for QA-allowlisted accounts; production "false".
    "HARIMU_NATION_WORK_ENABLED": "false",
