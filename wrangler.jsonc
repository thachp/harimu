{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harimu-preview",
  "account_id": "143bccf1a31c2161142c43845a8fc65d",
  // Custom entry re-exports vinext and adds the CityPresence Durable Object (#76).
  "main": "./worker/entry.ts",
  // Pinned to the installed workerd runtime; advance after upgrading/testing Wrangler.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "region": "gcp:us-central1" },
  // #247: scheduled Worker for AI Cabinet petition responses (no-op unless HARIMU_AI_CABINET_RESPONSES_ENABLED="true").
  "triggers": { "crons": ["*/15 * * * *"] },
  // Prepared preview connection; preview only; D1 remains available for rollback.
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "a1f662c88f3b485190c402d9548ae360"
  }],
  "ai": { "binding": "AI" },
  // Preview only: Workers observability keeps Worker console logs (for example the [notables] rejection lines) searchable in the dashboard; wrangler.prod.jsonc stays unchanged.
  // Invocation logs are off: Cloudflare documents that request metadata and headers are captured per invocation (changelog 2025-04-07) and documents no Cookie/Authorization redaction, so Clerk cookies or bearer tokens could be stored. Console logs stay on.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "workers_dev": true,
  "preview_urls": true,
  // Preview turns on every feature flag that is safe without an unset Worker secret (the Workers AI flags are on too, capped by HARIMU_AI_DAILY_BUDGET_MICRO; the QA2 smoke list is in the PR that did it). The "Off" in a flag comment below describes that flag's off behavior. wrangler.prod.jsonc keeps every flag "false".
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaGFyaW11LmNvbSQ",
    "NEXT_PUBLIC_HARIMU_DEVELOPMENT_PREVIEW": "true",
    "HARIMU_ACCOUNT_ELECTION_POC_ENABLED": "true",
    "HARIMU_STORAGE_MAINTENANCE": "false",
    "HARIMU_STORAGE_BACKEND": "postgres",
    "HARIMU_POSTGRES_CUTOVER_READY": "true",
    "HARIMU_POSTGRES_JOURNAL_RETENTION_APPROVED": "true",
    "HARIMU_POSTGRES_TEMPORARY_ADMIN_APPROVED": "true",
    "HARIMU_AI_NEWS_ENABLED": "true",
    "HARIMU_NOTABLES_ENABLED": "true",
    "HARIMU_AI_CABINET_RESPONSES_ENABLED": "true",
    "HARIMU_CITY_FOUNDING_ENABLED": "true",
    // #742: AI kill switch (operator control, not a feature flag). "" = off; "all" or a comma list of nation ids switches that narrative to templates (no model call, no AI spend). Unknown values fail closed to "all".
    "HARIMU_AI_TEMPLATES_ONLY": "",
    // #764: per-persona AI mute (operator control, not a feature flag). "" = off; "all" or a comma list of persona ids (Notable ids, <nation>-news-desk, kindle-cabinet, kindle-town-hall, kindle-debate) skips that persona's model calls. Unknown values fail closed to "all".
    "HARIMU_AI_MUTED_PERSONAS": "",
    "HARIMU_AI_DAILY_BUDGET_MICRO": "970000",
    "HARIMU_SQUARE_PURCHASE_ENABLED": "false",
    // #626 (Decision 111): the Spark-to-Tessera kiosk exchange, separate from square purchases. Off: buy-tessera is refused and the kiosk stays closed.
    "HARIMU_TESSERA_EXCHANGE_ENABLED": "false",
    // #631: preview-only Tessera TEST faucet (50.00 TSR once per citizen, labeled test). Off; it also needs NEXT_PUBLIC_HARIMU_DEVELOPMENT_PREVIEW=true, so production refuses it.
    "HARIMU_TEST_FAUCET_ENABLED": "true",
    "HARIMU_LABOR_BUREAU_ENABLED": "true",
    // #489: per-nation opening flags (seven-nations Stage 0). Off; even when "true" a nation is enrollable only by a QA-allowlisted account (lib/nation-openings.ts nationPlayable).
    // #487: Confluence PoC. "true" in preview only (QA-allowlisted accounts); production "false".
    "HARIMU_CONFLUENCE_ENABLED": "true",
    "HARIMU_MERIDIAN_ENABLED": "false",
    "HARIMU_ILMAR_ENABLED": "false",
    "HARIMU_HOARVALE_ENABLED": "false",
    "HARIMU_VARKAND_ENABLED": "false",
    "HARIMU_VELDWOOD_ENABLED": "false",
    "HARIMU_FULMARA_ENABLED": "false",
    // #486 (Stage 0 closeout): a flag-on nation opens only when its registry entry is complete (capital and biome, currency, wage fund, jobs). Off: unchanged.
    "HARIMU_NATION_READINESS_ENABLED": "true",
    "HARIMU_GRAY_MARKET_ENABLED": "true",
    // #736: per-citizen daily gray-market volume cap (posted + accepted LN per UTC day). Off: no cap, exactly the #43 behaviour.
    "HARIMU_GRAY_DAILY_CAP_ENABLED": "true",
    // #749: each completed Korund gray-market trade adds private Suspicion (capped per day, never starts Correction Duty). Off: Suspicion from discoveries only.
    "HARIMU_GRAY_SUSPICION_ENABLED": "true",
    // #797: after an accepted gray-market trade a checkpoint may seize part of the buyer's LN bundle (chance rises with Suspicion, capped; one per game day); seized LN is destroyed. Off: no roll, no write.
    "HARIMU_GRAY_SEIZURE_ENABLED": "true",
    // #737: Plan medals for weekly quota over-fulfilment (derived on read, no table). Off: no medal read, quota bar unchanged.
    "HARIMU_KORUND_MEDALS_ENABLED": "true",
    // #759: weekly quota shortfall shows an Inspection notice and a zero-bonus ledger line (derived on read, no table). Off: no shortfall read, panel unchanged.
    "HARIMU_KORUND_SHORTFALL_ENABLED": "true",
    // #824: Kindle Dormant Savings Shield: on return from Dormant or Archived, a verified Kindle citizen gets min(SPK balance, 240 SPK cap) x 1/2 x the Price Index rise, once per absence, from the treasury welfare line. Off: no read, no write, no copy.
    "HARIMU_SAVINGS_SHIELD_ENABLED": "true",
    // #844: Kindle sales tax: each fill on Kindle's goods market or fixed-lot listing sale (Kindle's market by definition; any seller nation) remits 5% of the gross from the proceeds to kindle-treasury (migrations 0081, 0083). Off: no tax row written and no tax INSERT runs; balances still sum the empty tax tables.
    "HARIMU_KINDLE_SALES_TAX_ENABLED": "true",
    // #886 (a): the MVP job-type catalog (8 types, ARC on #886) at GET /api/jobs/types. Off: 404; nothing else reads it.
    "HARIMU_MVP_JOB_TYPES_ENABLED": "true",
    // #781: move your home city within your own nation for a fee of 10 units of the nation's wallet currency (SPK Kindle, LN Korund; no wallet currency: not_open_yet), once per 7 real days (POST /api/city/home). Off: 404 before auth, no read or write; home stays the capital.
    "HARIMU_HOME_CITY_MOVE_ENABLED": "true",
    // #777: goods-market seller fee (0.5%, rounded down) written as a sink row with each fill and netted from the wallet. Off: no fee written or read.
    "HARIMU_MARKET_FEE_ENABLED": "true",
    // #758: Korund wallet shows the rumored LN street rate (from #43 trades, display only) to citizens who have traded on the gray market. Off: no read, wallet unchanged.
    "HARIMU_WALLET_STREET_RATE_ENABLED": "true",
    // #776: a closed-week plan shortfall withdraws goods (then clothing) coupons from the next week's book; the food ration is never cut (derived on read). Off: coupons unchanged.
    "HARIMU_KORUND_RATION_CUT_ENABLED": "true",
    // #490 (Stage 0d): generic per-nation wage ledger and work commands. Off: the commands are 404 and nothing is written. Also needs a nation that is playable for the account (#489) with jobs in lib/nation-openings.ts (only Confluence, #487).
    // #487: "true" in preview only so the Confluence cooperative job runs for QA-allowlisted accounts; production "false".
    "HARIMU_NATION_WORK_ENABLED": "true",
    // #529: Aurelle Royal Favor decays over time (read-time, no stored balance, no cron). Off: the Favor balance is exactly the flat rule of before. The window is an [ASSUMPTION] pending ARC.
    "HARIMU_FAVOR_DECAY_ENABLED": "true",
    "HARIMU_KINDLE_INCOME_TAX_ENABLED": "true",
    // #197: city order book API (fruit/meat/wood). Off until the board UI (#200) and QA.
    "HARIMU_ORDER_BOOK_ENABLED": "true",
    // #459: the market board re-reads GET /api/market/orders every 20 s while open and visible, with up/down markers. Off: no ticker key, no polling.
    "HARIMU_MARKET_TICKER_ENABLED": "true",
    "HARIMU_AURELLE_RISING_ENABLED": "true",
    // #281: Aurelle AI palace coup (plot, Power Weight, Crisis Window). Off until QA.
    "HARIMU_AURELLE_COUP_ENABLED": "true",
    // #531: Aurelle guild charter PoC (request/renew a market-stall charter for Royal Favor). Off: the charter route is a 404 and nothing is written.
    "HARIMU_AURELLE_CHARTERS_ENABLED": "true",
    // #465: earned-Tessera rewards (a fixed daily pool split pro-rata over verified settled Kindle shifts, claimed at a kiosk; no exchange, cash-out or conversion). Off: the rewards route is a 404 and the epoch-close cron is a no-op.
    "HARIMU_TESSERA_REWARDS_ENABLED": "false",
    // #283: Kindle mid-term Assembly election (D'Hondt per district, 5% district share). Off until QA. #351: the real calendar is driven by the world clock: set HARIMU_KINDLE_CYCLE_START_AT (epoch seconds, start of day 0 of the first 120-day cycle) and the vote opens at day 60 of every cycle for 72 hours. Without it, HARIMU_KINDLE_ASSEMBLY_OPEN_AT (epoch seconds) is a manual one-off open. Neither set: it never opens.
    "HARIMU_KINDLE_ASSEMBLY_ENABLED": "true",
    // #878: preview world day 0 = 2026-10-19T00:00:00Z (epoch seconds). Drives lib/election-calendars (Kindle cycle, Korund Congress, Aurelle claims). Production leaves it unset: every calendar is held.
    "HARIMU_KINDLE_CYCLE_START_AT": "1792368000",
    // #307: Kindle party membership and human primaries. Off until QA. Opening is manual: set HARIMU_PRIMARIES_OPEN_AT (epoch seconds) to open the 72-hour primary.
    "HARIMU_PRIMARIES_ENABLED": "true",
    "HARIMU_TRAVEL_ENABLED": "true",
    "HARIMU_KORUND_PRESIDIUM_ENABLED": "true",
    // #67: citizen faith, Devotion and daily worship. Off until the card UI and QA.
    "HARIMU_FAITH_ENABLED": "true",
    // #599: Diplomatic Hall (Kindle + Aurelle citizens, closed to Korund). Off: the route returns 404 and the tab is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_DIPLOMATIC_HALL_ENABLED": "true",
    // #82: map overlay toggles (Ownership, Resources, Unrest) next to the zoom cluster. Off: GET /api/citizen sends flags.mapOverlays false and nothing renders. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_MAP_OVERLAYS_ENABLED": "true",
    // #741: Kindle civic rank ladder (Resident → Leading Citizen; an honor, no office or vote weight). Off: GET /api/citizen/civic-rank is 404, /api/citizen sends no civicRank and kindle-7-rank is unavailable. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_CIVIC_RANK_ENABLED": "true",
    // #738 slice 1: army units: volunteer for your nation's home-guard unit, leave it, pick a squad stance. Needs HARIMU_WAR_ENABLED too. Off: /api/army is 404 and the card is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_ARMIES_ENABLED": "true",
    // #842: Religious Harmony (docs 14.5): a per-nation 0–100 score from festival holidays, festival joins, banned-festival joins and Korund raids, feeding Stability (±5) and shown on the faith panel (Korund: band only). Off: no Stability input, no panel line, no reads. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_RELIGIOUS_HARMONY_ENABLED": "true",
    // #738 slice 2: army drills: one drill per member per game day; current members' drills and shifts raise unit strength and morale on the card. Needs HARIMU_ARMIES_ENABLED and HARIMU_WAR_ENABLED too. Off: POST /api/army/drill is 404 and /api/army has no strength or morale. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_ARMY_DRILLS_ENABLED": "true",
    // #738 slice 4: army units on the map: the "Army positions" overlay shows each unit at its capital, or marching toward the enemy capital in a war its nation declared. Needs HARIMU_ARMIES_ENABLED and HARIMU_WAR_ENABLED too. Off: GET /api/army/positions is 404 and the overlay stays "Not available yet". Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_ARMY_MAP_ENABLED": "true",
    // #738 slice 5: supply lines from depots (each nation's capital); a unit marching beyond supply range loses strength each game day, shown on the army card and the Army positions legend. Needs HARIMU_ARMY_MAP_ENABLED and its flags. Off: no supply reads and the slice-4 shapes. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_ARMY_SUPPLY_ENABLED": "true",
    // #738 battles: an attacking unit staged next to the defender's capital fights deterministic 10-minute rounds from current strength (with supply loss) and morale; the capital is never captured. Needs HARIMU_ARMY_SUPPLY_ENABLED and its flags. Off: GET /api/army/battles is 404 and the card has no battle line. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_ARMY_BATTLES_ENABLED": "true",
    // #782: Kindle cosmetic "I Voted" badge after a written ballot (civic, preview or primary; docs 9.3). Derived from receipts, no currency. Off: GET /api/citizen/i-voted is 404 and the badge is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_I_VOTED_BADGE_ENABLED": "true",
    // #740 slice 1: Kindle polling PoC: voluntary voter-intent answers and one published poll per real day (n >= 10, margin 0.98/sqrt(n)). Off: /api/polling is 404 and the poll card is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_KINDLE_POLLING_ENABLED": "true",
    // #831: Kindle platform plank up-votes (docs 9.4): party members up-vote up to 3 of their party's pledges for the party AI to consider; visibility only, never votes or currency. Off: /api/planks is 404 and the card is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_PLANK_VOTES_ENABLED": "true",
    // #863: Kindle campaign donations PoC (docs 9.4): Tier-1 citizens donate Spark to an AI party, capped per party per week and publicly listed; never votes, ballot or primary weight. Off: /api/party-donations is 404 and the card is hidden. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_PARTY_DONATIONS_ENABLED": "true",
    // #867: Kindle rallies PoC (docs 9.4): one weekly rally per AI candidate in a Kindle city square, citizens mark attend once, an AI-labeled news clip after the rally; visibility only, never votes. Off: /api/rallies is 404, the card and news clips are hidden, the cron job never opens the database. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_KINDLE_RALLIES_ENABLED": "true",
    // #876: model-written Kindle rally speeches through the town hall AI pipeline (budget, platform-card check, safety model) on the rallies cron; templates-only or a muted kindle-rally persona keeps the #867 template speech. Needs HARIMU_KINDLE_RALLIES_ENABLED, the AI binding and budget. Off: no model call, the template speech is shown. Full-line comment only: scripts/development-config.mjs strips full-line comments.
    "HARIMU_AI_RALLY_SPEECHES_ENABLED": "true",
    // #881: city chat channel (one per city, current city only, 280 chars, 10 s / 20 per hour, 7-day retention, shadow-mute aware). Global and DMs follow.
    "HARIMU_CITY_CHAT_ENABLED": "true",
    // #881 part 2: global chat channel (every enrolled citizen, author nation shown, 280 chars, 10 s / 20 per hour, 7-day retention, shadow-mute aware). DMs follow.
    "HARIMU_GLOBAL_CHAT_ENABLED": "true",
    // #612: Founding Period PoC (docs coups-transitions 10.6): government read field, day-30 events on the world tick, national news line. Off: no new fields, no tick writes.
    "HARIMU_FOUNDING_PERIOD_ENABLED": "true",
    // #613: Aurelle hereditary succession PoC (docs coups-transitions 10.4-10.5): the operator succession command (illness, vacancy, abdication, accession) with one gazette item per transition. Off: the route returns 404 and nothing is read. Needs the HARIMU_AURELLE_SUCCESSION_ADMIN_SECRET Worker secret (set in the dashboard, never here).
    "HARIMU_AURELLE_SUCCESSION_ENABLED": "true",
    // #470 slice 2: relocation support claims after a city capture (Decision 109): one flat Tessera payout per eligible Kindle defender citizen from a capped protocol pot; no exchange, cash-out or conversion. Off: the claim route is a 404 and nothing is read.
    "HARIMU_RELOCATION_SUPPORT_ENABLED": "true",
    // #601: targeted goods sanctions PoC (docs 13.3): a nation bans named goods to another on top of the #363 embargo; food is never listed. Server-side proposals, decided on the citizen POST world tick. Off: nothing is created and trade checks are #363's alone.
    "HARIMU_TARGETED_SANCTIONS_ENABLED": "true",
    "HARIMU_WAR_ENABLED": "true",
    // #423: war weariness PoC (weekly Unrest from an active war, docs 15.3). Needs HARIMU_WAR_ENABLED too. Off until QA.
    "HARIMU_WAR_WEARINESS_ENABLED": "true",
    // #495: lost frontier squares (city captures) feed the war weariness add-on. Needs HARIMU_WAR_ENABLED and HARIMU_WAR_WEARINESS_ENABLED too. Casualties are not tracked, so they stay zero.
    "HARIMU_WAR_WEARINESS_LOSSES_ENABLED": "true",
    // #426: war declaration rate limits (1 per nation per 14 real days, 2 active offensive wars) and the casus belli (grievance score >= 40) gate. Needs HARIMU_WAR_ENABLED too. Off until QA.
    "HARIMU_WAR_DECLARATION_LIMITS_ENABLED": "true",
    // #427: the Kindle Assembly votes on the President's war declaration (more than half of all seats, decided on the next tick). Needs HARIMU_WAR_ENABLED too.
    "HARIMU_WAR_ASSEMBLY_ENABLED": "true",
    // #427 slice 2: war endings by surrender (the surrendering nation's own assembly) and concession of Frontier nation squares (both sides ratify), decided on the next tick. Needs HARIMU_WAR_ENABLED too.
    "HARIMU_WAR_ENDINGS_ENABLED": "true",
    // #308: AI treaties PoC (non-aggression pact, trade agreement). Off until QA; treaties are proposed and ratified by server code only.
    "HARIMU_DIPLOMACY_ENABLED": "true",
    // #363: embargo PoC (bilateral trade cut). Off until QA; embargoes are proposed and ratified by server code only.
    "HARIMU_EMBARGO_ENABLED": "true",
    // #362: Aurelle Crown debasement PoC (mint parity, Currency Confidence, Monarch decree). Off until QA; decrees are written only by the scheduled Worker.
    "HARIMU_CROWN_DEBASEMENT_ENABLED": "true",
    // #442: Kindle canvassing PoC (party members' ground-game quests; display-only district visibility, never votes). Off until QA.
    "HARIMU_CANVASSING_ENABLED": "true",
    // #441: Kindle town hall PoC (citizen questions for 24 hours, top 10 answered). Off until QA. An operator sets HARIMU_TOWN_HALL_OPEN_AT (epoch seconds) to open every candidate's hall; unset it never opens.
    "HARIMU_TOWN_HALLS_ENABLED": "true",
    // #441: the AI candidates' town hall answers, written only by the scheduled Worker. Off until QA; also needs HARIMU_TOWN_HALLS_ENABLED, the AI binding and a valid AI budget.
    "HARIMU_AI_TOWN_HALL_ANSWERS_ENABLED": "true",
    // #282: Kindle presidential debate PoC (citizen questions and up-votes through the town hall path, top 5 put to every AI candidate, fact-check panel). Off until QA. An operator sets HARIMU_DEBATE_OPEN_AT (epoch seconds) to open intake for 24 hours; unset it never opens.
    "HARIMU_DEBATE_ENABLED": "true",
    // #282: the AI candidates' debate answers, written only by the scheduled Worker. Off until QA; also needs HARIMU_DEBATE_ENABLED, the AI binding and a valid AI budget. Off, every answer is the candidate's fallback line.
    "HARIMU_AI_DEBATE_ANSWERS_ENABLED": "true",
    // #431: Kindle Spark money supply and Price Index PoC (Reserve Board issuance within the 3% cap and the Charter Limit). Off until QA; issuance is written only by the scheduled Worker.
    "HARIMU_SPARK_SUPPLY_ENABLED": "true",
    // #432: daily ledger reconciliation job and its read-only admin report route. Off until QA. The route also needs the HARIMU_ADMIN_TOKEN Worker secret (set in the dashboard, never in this file); without it the route is a 404.
    "HARIMU_LEDGER_RECONCILIATION_ENABLED": "true",
    // #614 / #880: read-only admin AI cost dashboard (GET /api/admin/ai-costs). Preview "true", production "false". HARIMU_ADMIN_TOKEN is a Worker secret, never a var.
    "HARIMU_AI_COST_DASHBOARD_ENABLED": "true",
    // #743: out-of-character Report intake for city chat messages and Notable replies (POST /api/reports, write-only; no mod console yet).
    "HARIMU_REPORTS_ENABLED": "true",
    // #753: staff AI review queue (docs §21.4): filter-failed Notable replies plus a ~1% sample of passing ones; admin list at /api/admin/ai-review-queue behind HARIMU_ADMIN_TOKEN.
    "HARIMU_AI_REVIEW_QUEUE_ENABLED": "true",
    // #739: citizen dormancy slice 1 (docs §17.4): Away/Dormant/Archived status and the Welcome back briefing; flag off = no last_active_at read or write.
    "HARIMU_DORMANCY_ENABLED": "true",
    // #789: read-only Kindle national budget card (docs §12.12): treasury balance and income-tax inflow from the ledger.
    "HARIMU_KINDLE_BUDGET_VIEW_ENABLED": "true",
    // #825: Kindle vote-buying watch (docs §9.5): a player-market transfer within 48h of a Kindle vote, from a party member, campaign actor or 3+-voter payer, records an investigation event.
    "HARIMU_VOTE_BUYING_WATCH_ENABLED": "true",
    "HARIMU_AI_GATEWAY_ID": "harimu-preview",
    // Realtime presence spike (#76): server and client flags; on in preview (preview-flags-on), "false" in production.
    "HARIMU_REALTIME_PRESENCE": "true",
    "NEXT_PUBLIC_HARIMU_REALTIME_PRESENCE": "true",
    "NEXT_PUBLIC_HARIMU_NATION_SYMBOLS": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_CREST": "true",
    "NEXT_PUBLIC_HARIMU_TOPBAR_EMBLEM": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_TOPBAR": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_PANEL": "true",
    "NEXT_PUBLIC_HARIMU_MOD_CONSOLE": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_RAIL": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_WORLD": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_NATION": "true",
    "NEXT_PUBLIC_HARIMU_UI_V2_CITY": "true",
    // #392 S8: phone layout for UI v2 (rail and tabs as a bottom tab bar, panel as a bottom sheet); needs UI_V2_RAIL.
    "NEXT_PUBLIC_HARIMU_UI_V2_MOBILE": "true",
    // #392 S9: Household panel in the v2 shape (Wallet, Food, Residence, Pantry rows; family cards with the Vale portraits); existing data only.
    "NEXT_PUBLIC_HARIMU_UI_V2_HOUSEHOLD": "true",
    // #243: filler wire stories (lib/press-templates.ts packs) in the National news edition under their in-world byline; they give way once a player paper publishes.
    "NEXT_PUBLIC_HARIMU_WIRE_BYLINES": "true",
    // #85: nation skin PoC on the top bar (Kindle / Korund / Aurelle colors + one CSS motif each); guests and pre-citizens keep the neutral bar.
    "NEXT_PUBLIC_HARIMU_NATION_SKIN": "true",
    "NEXT_PUBLIC_HARIMU_RARE_MARKER": "true",
    // #790: square chat shadow-mute (docs 21.3), new messages only. Operator list of citizenId@muteISO or citizenId@muteISO..unmuteISO entries (max 90; unmute by closing the window, not deleting it), comma-separated, not a secret. Empty: nobody is muted. Malformed: mutes nobody, logs a warning.
    // #790 unmute: close the window (id@mute..unmute) so posts made during the mute stay hidden. Deleting an entry reveals that window's posts; only do it as a deliberate admin action.
    "HARIMU_CHAT_SHADOW_MUTE": "",
    // QA tooling (#138): preview-only nation switch for allowlisted QA account ids (set ids in the dashboard; --keep-vars keeps them).
    "HARIMU_QA_TEST_CITIZENS": "false"
  },
  // Isolated preview only; never bind this resource as migrated production.
