{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/build-development.mjs --dev",
    "build": "node scripts/build-development.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:postgres:migrate": "node scripts/apply-postgres-migrations.mjs",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:sql": "python3 scripts/test-sql.py",
    "deploy": "npm run check && npm run build && npm run deploy:cloudflare",
    "check": "npm test && npm run test:sql && npm run lint && tsc --noEmit",
    "test:postgres": "HARIMU_TEST_STORAGE=postgres node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "test:layout": "node --experimental-strip-types scripts/hud-layout-check.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.19.0",
    "@clerk/nextjs": "^7.9.5",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.3",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.9",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^21.0.1",
    "playwright": "1.64.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
